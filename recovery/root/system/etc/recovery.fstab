# также взято из twrp gaguga 3.2.1-0 
# blk_device                                    mount_point fs_type  mnt_flags           fs_mgr_flags

# Загрузочные и сервисные raw-разделы (emmc)
/dev/block/bootdevice/by-name/kernel            /kernel     emmc     defaults            defaults
/dev/block/bootdevice/by-name/recovery_ramdisk  /recovery   emmc     defaults            defaults
/dev/block/bootdevice/by-name/erecovery_ramdisk /e_recovery emmc     defaults            defaults
/dev/block/bootdevice/by-name/misc              /misc       emmc     defaults            defaults
/dev/block/bootdevice/by-name/oeminfo           /oeminfo    emmc     defaults            defaults
/dev/block/bootdevice/by-name/frp               /frp        emmc     defaults            defaults

