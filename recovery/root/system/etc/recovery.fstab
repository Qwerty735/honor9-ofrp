/kernel			emmc	/dev/block/bootdevice/by-name/kernel		       flags=display="Kernel";backup=1;flashimg
/cache		    ext4    /dev/block/bootdevice/by-name/cache		           flags=display="Cache";backup=1;wipeingui
/cust		    ext4	/dev/block/bootdevice/by-name/cust		           flags=display="Cust";backup=1;wipeingui
/data		    f2fs	/dev/block/bootdevice/by-name/userdata	           flags=display="Data";backup=1;wipeingui
/oeminfo        emmc	/dev/block/bootdevice/by-name/oeminfo	           flags=display="Oeminfo";backup=1
/product	    ext4	/dev/block/bootdevice/by-name/product	           flags=display="Product";backup=1;wipeingui
/recovery       emmc	/dev/block/bootdevice/by-name/recovery_ramdisk	   flags=display="Recovery";backup=1;flashimg
/e_recovery     emmc    /dev/block/bootdevice/by-name/erecovery_ramdisk    flags=display="E-Recovery";backup=1;flashimg
/system		    ext4	/dev/block/bootdevice/by-name/system	           flags=display="System";backup=1;wipeingui
/vendor		    ext4	/dev/block/bootdevice/by-name/vendor	           flags=display="Vendor";backup=1;wipeingui
/version	    ext4	/dev/block/bootdevice/by-name/version	           flags=display="Version";backup=1;wipeingui
/odm		    ext4	/dev/block/bootdevice/by-name/odm		           flags=display="Odm";backup=1;wipeingui
/cust_image		emmc	/dev/block/bootdevice/by-name/cust		           flags=flashimg=1;backup=1;display="Cust Image"
/system_image	emmc	/dev/block/bootdevice/by-name/system               flags=flashimg=1;backup=1;display="System Image"
/version_image	emmc	/dev/block/bootdevice/by-name/version	           flags=flashimg=1;backup=1;display="Version Image"
/vendor_image   emmc	/dev/block/bootdevice/by-name/vendor	           flags=flashimg=1;backup=1;display="Vendor Image"
/product_image	emmc	/dev/block/bootdevice/by-name/product	           flags=flashimg=1;backup=1;display="Product Image"
/oeminfo_image	emmc	/dev/block/bootdevice/by-name/oeminfo              flags=flashimg=1;backup=1;display="Oeminfo Image"
/frp_image		emmc	/dev/block/bootdevice/by-name/frp		           flags=flashimg=1;backup=1;display="Frp Image"
/external_sd	vfat	/dev/block/mmcblk1p1	/dev/block/mmcblk1	       flags=display="MicroSD Card";storage;wipeingui;removable
/usbotg		    auto	/dev/block/sde1         /dev/block/sde             flags=display="USB OTG";storage;removable;backup=0
