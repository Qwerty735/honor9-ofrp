# blk_device              mount_point  fs_type  mnt_flags     fs_mgr_flags
/dev/block/mmcblk0p17     /cache       ext4     nosuid,nodev  wait
/dev/block/mmcblk0p56     /vendor      ext4     ro            wait
/dev/block/mmcblk0p57     /product     ext4     ro            wait
/dev/block/mmcblk0p59     /system      ext4     ro            wait
/dev/block/mmcblk0p64     /data        f2fs     nosuid,nodev  wait
