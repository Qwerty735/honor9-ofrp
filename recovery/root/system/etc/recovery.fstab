# также взято из twrp gaguga 3.2.1-0 
# blk_device                                    mount_point fs_type  mnt_flags           fs_mgr_flags

# Основные разделы системы и прошивки
/dev/block/bootdevice/by-name/system            /system     ext4     ro                  wait
/dev/block/bootdevice/by-name/vendor            /vendor     ext4     ro                  wait
/dev/block/bootdevice/by-name/product           /product    ext4     ro                  wait
/dev/block/bootdevice/by-name/odm               /odm        ext4     ro                  wait
/dev/block/bootdevice/by-name/cust              /cust       ext4     ro                  wait
/dev/block/bootdevice/by-name/version           /version    ext4     ro                  wait

# Пользовательские данные и кэш
/dev/block/bootdevice/by-name/cache             /cache      ext4     nosuid,nodev        wait
/dev/block/bootdevice/by-name/userdata          /data       f2fs     nosuid,nodev        wait,length=-16384,fileencryption=aes-256-xts:aes-256-cts,reservedsize=20M

# Загрузочные и сервисные raw-разделы (emmc)
/dev/block/bootdevice/by-name/kernel            /kernel     emmc     defaults            defaults
/dev/block/bootdevice/by-name/recovery_ramdisk  /recovery   emmc     defaults            defaults
/dev/block/bootdevice/by-name/erecovery_ramdisk /e_recovery emmc     defaults            defaults
/dev/block/bootdevice/by-name/misc              /misc       emmc     defaults            defaults
/dev/block/bootdevice/by-name/oeminfo           /oeminfo    emmc     defaults            defaults
/dev/block/bootdevice/by-name/frp               /frp        emmc     defaults            defaults

# Внешние накопители
/dev/block/mmcblk1p1                            /external_sd vfat    defaults            defaults
/dev/block/sde1                                 /usb-otg    vfat     defaults            defaults
