# mount point    fstype    device                    device2              flags
/cache           ext4      /dev/block/mmcblk0p17
/odm             ext4      /dev/block/mmcblk0p18                          flags=display="ODM";backup=1;wipeingui
/version         ext4      /dev/block/mmcblk0p55                          flags=display="Version";backup=1;wipeingui
/vendor          ext4      /dev/block/mmcblk0p56                          flags=display="Vendor";backup=1;wipeingui
/vendor_image    emmc      /dev/block/mmcblk0p56                          flags=display="Vendor Image";backup=1;flashimg=1
/product         ext4      /dev/block/mmcblk0p57                          flags=display="Product";backup=1;wipeingui
/product_image   emmc      /dev/block/mmcblk0p57                          flags=display="Product Image";backup=1;flashimg=1
/cust            ext4      /dev/block/mmcblk0p58                          flags=display="Cust";backup=1;wipeingui
/system          ext4      /dev/block/mmcblk0p59                          flags=display="System";backup=1;wipeingui
/system_image    emmc      /dev/block/mmcblk0p59                          flags=display="System Image";backup=1;flashimg=1
/data            f2fs      /dev/block/mmcblk0p64                          flags=fileencryption=aes-256-xts:aes-256-cts;encryptable=footer

# Внешние накопители (обязательно для OrangeFox)
/external_sd     auto      /dev/block/mmcblk1p1      /dev/block/mmcblk1   flags=display="MicroSD";storage;wipeingui;removable
/usb-otg         auto      /dev/block/sda1           /dev/block/sda       flags=display="USB OTG";storage;wipeingui;removable

