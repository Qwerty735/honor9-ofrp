ro.sf.lcd_density=420
ro.hardware=hi3660
ro.hardware.keystore=hisi
sys.usb.configfs=1
sys.usb.controller=ff100000.dwc3
persist.sys.usb.config=adb
ro.adb.secure=0
ro.secure=0
ro.debuggable=1
ro.vendor.camera.platform_name=STF
# Keep vold/TWRP away from metadata encryption and Keystore 2: on this
# recovery neither can work (the ramdisk has no usable TEE/keystore
# implementation) and the failed keystore2 interface lookups are what floods
# the kernel log right before the reboot.
ro.crypto.volume.metadata.encryption=false
ro.crypto.state=unsupported
